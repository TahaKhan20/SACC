# LangGraph AP Invoice Triage Agent -- Environment Configuration
# Copy this file to .env and fill in the values.

# ── SACC Mock API Server ──────────────────────────────────────────────────
# Base URL of the SACC FastAPI mock server (from the parent project)
SACC_API_BASE_URL=http://localhost:8000

# ── SAP Document AI (Real API -- TODO: fill in for production) ──────────────
# These are for the REAL SAP Document AI service, not the mock.
# The triage agent will use these when the SACC mock APIs are insufficient.
SAP_DOCAI_BASE_URL=
SAP_DOCAI_CLIENT_ID=
SAP_DOCAI_CLIENT_SECRET=
SAP_DOCAI_AUTH_URL=

# ── Schema IDs (Guids -- must exist in Document AI service) ────────────────
# Leave empty to auto-generate placeholder GUIDs in the mock.
CLASSIFICATION_SCHEMA_ID=
FUEL_INVOICE_SCHEMA_ID=
CHARTER_INVOICE_SCHEMA_ID=
SERVICE_INVOICE_SCHEMA_ID=
GENERIC_INVOICE_SCHEMA_ID=

# ── Company Configuration ──────────────────────────────────────────────────
# The fixed company that documents must belong to.
CONFIGURED_COMPANY_CODE=1000
CONFIGURED_COMPANY_NAME=SACC Airlines
CONFIGURED_COMPANY_VAT=
CONFIGURED_COMPANY_TAX_IDS=

# Intercompany company codes (comma-separated)
INTERCOMPANY_COMPANY_CODES=2000,3000

# ── Confidence Thresholds ──────────────────────────────────────────────────
MIN_CONFIDENCE_THRESHOLD=0.75
MIN_REQUIRED_FIELD_CONFIDENCE=0.80

# ── LLM Configuration (optional -- for LLM-enhanced classification) ────────
LLM_MODEL_NAME=gpt-4
LLM_API_KEY=
LLM_BASE_URL=